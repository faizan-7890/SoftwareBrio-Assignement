# LLM Configuration
# Choose provider: 'openai', 'groq', 'ollama', or 'mock' (default: 'mock' if no keys provided)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Groq Configuration (Free tier: fast inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Configuration (Local)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Optional Search API Keys (External LinkedIn Founder Discovery)
# DuckDuckGo search is used by default with ZERO api keys required.
TAVILY_API_KEY=your_tavily_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here

# Crawler Settings
HEADLESS=true
PAGE_TIMEOUT_MS=15000
MAX_SUBPAGES_PER_DOMAIN=4
WAIT_AFTER_LOAD_MS=1500
